#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
release=$(CDPATH= cd -- "$root/current" && pwd -P)
export PATH="$release/runtime/bin:$PATH"
export MINI_AGENT_CODEX_BIN="$release/backend/node_modules/.bin/codex"
export MINI_AGENT_CLAUDE_SDK="$release/backend/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs"
export MINI_AGENT_DATA_DIR="$root/data"
export MINI_AGENT_WORKSPACE_DIR="$root/workspace"
exec "$release/runtime/bin/node" "$release/app/scripts/launch.mjs" "$@"
