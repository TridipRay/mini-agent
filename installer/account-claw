#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
release=$(CDPATH= cd -- "$root/current" && pwd -P)
export PATH="$release/runtime/bin:$PATH"
export ACCOUNT_CLAW_OPENCLAW="$release/backend/node_modules/openclaw/openclaw.mjs"
export ACCOUNT_CLAW_DATA_DIR="$root/data"
export ACCOUNT_CLAW_WORKSPACE_DIR="$root/workspace"
exec "$release/runtime/bin/node" "$release/app/claw/cli.mjs" "$@"
